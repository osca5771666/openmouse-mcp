{
  "mcpServers": {
    "openmouse": {
      "command": "python",
      "args": [
        "-u",
        "./bin/openmouse-mcp-launcher.py"
      ],
      "env": {
        "MOUSE_MCP_ENV": "auto",
        "MOUSE_MCP_CLOUD_BROWSER": "off",
        "MOUSE_MCP_SPEED_PROFILE": "fast",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
